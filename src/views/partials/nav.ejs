<% if (typeof showParda !== 'undefined' && showParda) { %><div class="parda" aria-hidden="true"><div class="half l"></div><div class="half r"></div></div><% } %>
<nav class="top">
  <div class="inner">
    <a class="brandmark" href="<%= L %>/"><img src="/img/logo-full.png" alt="Devikka by Deepika" width="693" height="900" decoding="async"></a>
    <div class="navlinks">
      <a class="lnk" href="<%= L %>/shop"><%= t.nav.shop %></a>
      <a class="lnk" href="<%= L %>/dress-pack"><%= t.nav.pack %></a>
      <a class="lnk" href="<%= L %>/mandir-seva"><%= t.nav.seva %></a>
      <a class="lnk" href="<%= L %>/festivals"><%= t.nav.festivals %></a>
      <a class="lnk" href="<%= L %>/story"><%= t.nav.story %></a>
      <a class="lnk" href="<%= L %>/account"><%= customer ? t.nav.account : t.nav.login %></a>
    </div>
    <button class="themetoggle" id="themeToggle" type="button" aria-pressed="false">
      <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <span class="tlabel"><%= t.misc.light %></span>
    </button>
    <a class="lnk" href="<%= locale === 'hi' ? path : '/hi' + (path === '/' ? '/' : path) %>" hreflang="<%= locale === 'hi' ? 'en' : 'hi' %>"><%= t.misc.lang %></a>
    <a class="btn btn-primary" href="<%= L %>/cart"><%= t.nav.cart %><%= cartCount ? ' · ' + cartCount : '' %></a>
  </div>
</nav>
<main id="main">
<% if (flash && flash.msg && flash.msg !== 'added') { %><div class="wrap" style="padding-top:18px;"><div class="notice <%= flash.ok ? 'ok' : 'err' %>"><%= flash.msg %></div></div><% } %>
