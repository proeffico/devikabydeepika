<%- include('_top') %><div class="row" style="justify-content:space-between;"><h1>Products</h1><a class="btn btn-primary btn-sm" href="/admin/products/new">New product</a></div>
<table class="tbl"><tr><th>ID</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Flags</th></tr><% for (const p of products) { %><tr><td><%= p.id %></td><td><a href="/admin/products/<%= p.id %>"><%= p.name_en %></a><br><small><%= p.slug %></small></td><td><%= p.cat %></td><td><%= p.base_price?money(p.base_price):'by band' %></td><td><%= p.stock %></td><td><%= p.price_is_estimate?'ESTIMATE ':'' %><%= p.is_featured?'featured ':'' %><%= p.is_active?'':'INACTIVE' %></td></tr><% } %></table><%- include('_bottom') %>
