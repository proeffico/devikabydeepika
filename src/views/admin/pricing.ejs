<%- include('_top') %><h1>Pricing</h1>
<div class="grid2"><div class="panel"><h3>Visit plans (by mandir footprint)</h3><% for (const p of plans) { %><form method="post" action="/admin/pricing/plans/<%= p.id %>" class="inline" style="margin:6px 0;"><input type="hidden" name="_csrf" value="<%= csrf %>"><b style="width:120px;display:inline-block;"><%= p.label_en %></b> monthly <input name="monthly_price" type="number" value="<%= p.monthly_price %>" style="width:90px;"> quarterly <input name="quarterly_price" type="number" value="<%= p.quarterly_price %>" style="width:90px;"><button class="btn btn-ghost btn-sm">Save</button></form><% } %></div>
<div class="panel"><h3>Combo discount ladder (%)</h3><form method="post" action="/admin/pricing/ladder"><input type="hidden" name="_csrf" value="<%= csrf %>"><% for (const l of ladder) { %><label><%= l.deity_count %><%= l.deity_count===4?'+':'' %> deities <%= l.is_estimate?'(estimate)':'' %></label><input name="d<%= l.deity_count %>" type="number" min="0" max="60" step="0.5" value="<%= l.discount_pct %>"><% } %><p><button class="btn btn-primary btn-sm">Save ladder</button></p></form>
<h3 style="margin-top:14px;">Per-band poshak prices</h3><p class="areas">Set on each product under Products → size-band variants. Untick "price is an estimate" once the tailor confirms.</p></div></div><%- include('_bottom') %>
