<%- include('../partials/head') %><main style="max-width:420px;margin:80px auto;padding:0 20px;"><div class="panel"><h1>Admin login</h1><% if (error) { %><div class="notice err"><%= error %></div><% } %>
<form method="post" action="/admin/login" class="booking"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="e">Email</label><input id="e" name="email" type="email" required autofocus></div><div class="field"><label for="p">Password</label><input id="p" name="password" type="password" required minlength="8"></div><button class="btn btn-primary" type="submit">Log in</button></form></div></main></body></html>
