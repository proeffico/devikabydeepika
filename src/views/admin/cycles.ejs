<%- include('_top') %><h1>Open cycles</h1><p class="areas">Production queue. Each row is one household's next delivery.</p>
<table class="tbl"><tr><th>Due</th><th>Kind</th><th>Customer</th><th>#</th><th>State</th><th>Choice link</th><th></th></tr><% for (const r of rows) { %><tr><td><%= r.due_date %></td><td><%= r.kind %></td><td><%= r.name||'' %> <%= r.phone %></td><td><%= r.cycle_no %></td><td><%= r.state %></td><td><code>/choose/<%= r.choice_token %></code></td>
<td><form method="post" action="/admin/cycles/<%= r.id %>/state" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="state"><% for (const s of ['pending_choice','chosen','in_production','ready','dispatched','delivered','closed','skipped']) { %><option <%= r.state===s?'selected':'' %>><%= s %></option><% } %></select><button class="btn btn-ghost btn-sm">Set</button></form></td></tr><% } %></table><%- include('_bottom') %>
