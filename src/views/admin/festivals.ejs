<%- include('_top') %><h1>Festival packs</h1><p class="areas">Set the pack price and the next date season by season. Blank price shows "Reserve on WhatsApp".</p>
<% for (const f of rows) { %><form method="post" action="/admin/festivals/<%= f.id %>" class="panel" style="margin-bottom:12px;"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3><%= f.name_en %> <small>(<%= f.season_en %>)</small></h3>
<div class="grid2"><div><label>Pack price (₹)</label><input name="pack_price" type="number" min="0" value="<%= f.pack_price||'' %>"><label>Next date</label><input name="next_date" type="date" value="<%= f.next_date?new Date(f.next_date).toISOString().slice(0,10):'' %>"></div>
<div><label>Contents (EN)</label><textarea name="pack_en" rows="3" style="width:100%;"><%= f.pack_en %></textarea><label>Contents (HI)</label><textarea name="pack_hi" rows="3" style="width:100%;"><%= f.pack_hi %></textarea></div></div><button class="btn btn-primary btn-sm">Save</button></form><% } %><%- include('_bottom') %>
