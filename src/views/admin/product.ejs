<%- include('_top') %><h1><%= p ? 'Edit: ' + p.name_en : 'New product' %></h1>
<form method="post" action="/admin/products<%= p?'/'+p.id:'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="grid2"><div class="panel">
  <label>Name (EN)</label><input name="name_en" required value="<%= p?p.name_en:'' %>"><label>Name (HI)</label><input name="name_hi" required value="<%= p?p.name_hi:'' %>"><label>Slug</label><input name="slug" value="<%= p?p.slug:'' %>" placeholder="auto from name">
  <label>Category</label><select name="category_id"><% for (const c of cats) { %><option value="<%= c.id %>" <%= p&&p.category_id===c.id?'selected':'' %>><%= c.name_en %> (<%= c.pricing_mode %>)</option><% } %></select>
  <label>Sub-category</label><select name="subcategory_id"><option value="">—</option><% for (const s of subs) { %><option value="<%= s.id %>" <%= p&&p.subcategory_id===s.id?'selected':'' %>><%= cats.find(c=>c.id===s.category_id).name_en %> › <%= s.name_en %></option><% } %></select>
  <label>Description (EN)</label><textarea name="description_en" rows="4" style="width:100%;"><%= p?p.description_en:'' %></textarea><label>Description (HI)</label><textarea name="description_hi" rows="4" style="width:100%;"><%= p?p.description_hi:'' %></textarea>
  <label>Fabric (EN)</label><input name="fabric_en" value="<%= p?p.fabric_en||'':'' %>"><label>Fabric (HI)</label><input name="fabric_hi" value="<%= p?p.fabric_hi||'':'' %>">
  <label>Image path (in /public/img)</label><input name="image_path" value="<%= p&&p.images&&p.images[0]?p.images[0].path:'' %>" placeholder="poshak-everyday-pink.jpg">
  <label>Meta title (EN)</label><input name="meta_title_en" value="<%= p?p.meta_title_en||'':'' %>"><label>Meta description (EN)</label><input name="meta_desc_en" value="<%= p?p.meta_desc_en||'':'' %>">
</div><div class="panel">
  <label>SKU</label><input name="sku" value="<%= p?p.sku||'':'' %>"><label>Per-piece price (leave blank if priced by band)</label><input name="base_price" type="number" step="1" min="0" value="<%= p&&p.base_price!==null?p.base_price:'' %>"><label>Per-piece stock</label><input name="stock" type="number" min="0" value="<%= p?p.stock:0 %>">
  <h4 style="margin-top:14px;">Size-band variants (blank = not offered)</h4><table class="tbl"><% for (const b of bands) { const v = p&&p.variants?p.variants.find(x=>x.size_band_id===b.id):null; %><tr><td><%= b.code %> <%= b.label_en %></td><td><input name="variant_price_<%= b.id %>" type="number" min="0" placeholder="price" value="<%= v?v.price:'' %>"></td><td><input name="variant_stock_<%= b.id %>" type="number" min="0" placeholder="stock" value="<%= v?v.stock:'' %>"></td></tr><% } %></table>
  <label>Deities</label><div class="opt"><% for (const d of deities) { %><label><input type="checkbox" name="deity_ids" value="<%= d.id %>" <%= p&&p.deityIds&&p.deityIds.includes(d.id)?'checked':'' %>> <%= d.name_en %></label><% } %></div>
  <label>Festivals</label><div class="opt"><% for (const f of fests) { %><label><input type="checkbox" name="festival_ids" value="<%= f.id %>" <%= p&&p.festivalIds&&p.festivalIds.includes(f.id)?'checked':'' %>> <%= f.name_en %></label><% } %></div>
  <label>Flags</label><div class="opt"><label><input type="checkbox" name="price_is_estimate" value="1" <%= p&&p.price_is_estimate?'checked':'' %>> price is an estimate</label><label><input type="checkbox" name="one_of_one" value="1" <%= p&&p.one_of_one?'checked':'' %>> one of one</label><label><input type="checkbox" name="is_featured" value="1" <%= p&&p.is_featured?'checked':'' %>> featured</label><label><input type="checkbox" name="is_active" value="1" <%= !p||p.is_active?'checked':'' %>> active</label></div>
  <p style="margin-top:16px;"><button class="btn btn-primary" type="submit">Save</button> <% if (p) { %><a class="btn btn-ghost btn-sm" href="/product/<%= p.slug %>" target="_blank">View</a><% } %></p>
</div></div></form><%- include('_bottom') %>
