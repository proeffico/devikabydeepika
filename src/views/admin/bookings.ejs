<%- include('_top') %><h1>Visit bookings</h1>
<table class="tbl"><tr><th>Date</th><th>Slot</th><th>Kind</th><th>Name</th><th>Phone</th><th>Pin</th><th>Footprint</th><th>Dressing</th><th>Idols</th><th>Status / sevadar</th></tr><% for (const b of rows) { %><tr><td><%= b.visit_date %></td><td><%= b.slot %></td><td><%= b.kind %></td><td><%= b.name %></td><td><%= b.phone %></td><td><%= b.pincode %></td><td><%= b.footprint||'' %></td><td><%= b.dressing_pref %></td><td><%= b.idols_note||'' %></td>
<td><form method="post" action="/admin/bookings/<%= b.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><% for (const s of ['requested','confirmed','done','cancelled','no_show']) { %><option <%= b.status===s?'selected':'' %>><%= s %></option><% } %></select><select name="sevadar_id"><option value="">— sevadar —</option><% for (const s of sevadars) { %><option value="<%= s.id %>" <%= b.sevadar_id===s.id?'selected':'' %>><%= s.name %></option><% } %></select><button class="btn btn-ghost btn-sm">Save</button></form></td></tr><% } %></table><%- include('_bottom') %>
