<%- include('_top') %><h1><%= o.order_no %> <span class="badge"><%= o.status %></span></h1>
<div class="grid2"><div class="panel"><h3>Ship to</h3><p><%= o.ship_name %><br><%= o.ship_phone %><br><%= o.ship_line1 %><%= o.ship_line2?', '+o.ship_line2:'' %><br><%= o.ship_city %>, <%= o.ship_state %> <%= o.ship_pincode %></p><% if (o.notes) { %><p><em><%= o.notes %></em></p><% } %>
  <form method="post" action="/admin/orders/<%= o.id %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><% for (const s of ['paid','in_production','ready','dispatched','delivered','cancelled','refunded']) { %><option <%= o.status===s?'selected':'' %>><%= s %></option><% } %></select><button class="btn btn-primary btn-sm">Update</button></form></div>
<div class="panel"><h3>Items</h3><table class="tbl"><% for (const it of o.items) { %><tr><td><%= it.name_snapshot %></td><td><%= it.band_snapshot||'' %></td><td>× <%= it.qty %></td><td><%= money(it.line_total) %></td></tr><% } %><tr><td colspan="3"><b>Total</b></td><td><b><%= money(o.total) %></b></td></tr></table>
  <h3>Payments</h3><table class="tbl"><% for (const p of o.payments) { %><tr><td><%= p.provider_payment_id||'—' %></td><td><%= p.status %></td><td><%= p.method||'' %></td><td><%= money(p.amount) %></td></tr><% } %></table></div></div><%- include('_bottom') %>
