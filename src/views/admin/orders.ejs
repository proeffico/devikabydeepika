<%- include('_top') %><h1>Orders</h1><p class="row"><% for (const s of ['','pending_payment','paid','in_production','ready','dispatched','delivered','cancelled']) { %><a class="chip <%= (status||'')===s?'on':'' %>" href="/admin/orders<%= s?'?status='+s:'' %>"><%= s||'all' %></a><% } %></p>
<table class="tbl"><tr><th>No</th><th>Customer</th><th>Pin</th><th>Status</th><th>Total</th><th>Placed</th></tr><% for (const o of orders) { %><tr><td><a href="/admin/orders/<%= o.id %>"><%= o.order_no %></a></td><td><%= o.ship_name %> · <%= o.ship_phone %></td><td><%= o.ship_pincode %></td><td><%= o.status %></td><td><%= money(o.total) %></td><td><%= new Date(o.created_at).toLocaleString('en-IN') %></td></tr><% } %></table><%- include('_bottom') %>
