<%- include('_top') %><h1>Sevadars</h1>
<table class="tbl"><tr><th>Name</th><th>Phone</th><th>Area</th><th>Exp</th><th>Note</th><th>Applied</th><th>Status / pay per visit</th></tr><% for (const s of rows) { %><tr><td><%= s.name %></td><td><%= s.phone %></td><td><%= s.area %></td><td><%= s.has_experience?'yes':'no' %></td><td><%= s.note||'' %></td><td><%= new Date(s.created_at).toLocaleDateString('en-IN') %></td>
<td><form method="post" action="/admin/sevadars/<%= s.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><% for (const st of ['applied','interview','verified','active','inactive','rejected']) { %><option <%= s.status===st?'selected':'' %>><%= st %></option><% } %></select><input name="pay_per_visit" type="number" min="0" placeholder="₹/visit" value="<%= s.pay_per_visit||'' %>" style="width:90px;"><button class="btn btn-ghost btn-sm">Save</button></form></td></tr><% } %></table><%- include('_bottom') %>
